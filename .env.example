# Porta HTTP do hub
PORT=3900
# URL pública (HTTPS em produção) — base dos redirect_uri do OAuth.
# Ex.: https://azuresystem.com.br/azurehub  (cadastre <PUBLIC_URL>/oauth/<plataforma>/callback em cada app)
PUBLIC_URL=http://localhost:3900
# Chave mestra que cifra as credenciais no banco do hub.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Vazio = gerada e guardada em data/.secret
HUB_SECRET=
# Pasta do banco interno (SQLite)
HUB_DATA_DIR=data
# Tamanho máximo de foto/vídeo baixado do site (MB)
MAX_MEDIA_MB=100
# Duração da sessão do painel (horas)
SESSION_HOURS=12
# Precificação (opcional): Python com Scrapling para a fonte "Site por seletores CSS"
# PRICE_SCRAPER_CMD=/opt/azurehub-scraper/bin/python
# Libera a pesquisa de preços em endereços da rede interna (só para testes)
# PRICE_ALLOW_PRIVATE=1
